// Módulo kanban: funis de vendas. Contato, conversa, equipe e membro são de
// outros módulos: só ids.

// Funil (quadro) da conta. Entrada automática na primeira etapa: conversas
// novas — todas ("all"), só as de uma equipe ("team") ou nenhuma ("none") — e
// leads do formulário do site (autoAddLeads).
model Board {
  id            String           @id @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  name          String
  autoAddMode   String           @default("none") @map("auto_add_mode")
  autoAddTeamId String?          @map("auto_add_team_id") @db.Uuid
  autoAddLeads  Boolean          @default(false) @map("auto_add_leads")
  createdAt     DateTime         @map("created_at") @db.Timestamptz(3)
  columns       BoardColumn[]
  deals         Deal[]
  automations   AutomationRule[]

  @@unique([tenantId, name])
  @@index([tenantId, autoAddMode])
  @@map("boards")
  @@schema("kanban")
}

model BoardColumn {
  id          String           @id @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  boardId     String           @map("board_id") @db.Uuid
  board       Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  // Ordem da coluna no quadro (0, 1, 2...).
  position    Int
  deals       Deal[]
  automations AutomationRule[]

  @@index([tenantId, boardId, position])
  @@map("board_columns")
  @@schema("kanban")
}

// Negócio (oportunidade) de um contato num funil. A conversa é opcional: o
// lead do formulário entra sem conversa até alguém falar com ele.
model Deal {
  id              String      @id @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  boardId         String      @map("board_id") @db.Uuid
  board           Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // NoAction (checado no fim do comando): apagar o funil leva etapas e
  // negócios juntos; apagar só a etapa com negócios dentro falha.
  columnId        String      @map("column_id") @db.Uuid
  column          BoardColumn @relation(fields: [columnId], references: [id], onDelete: NoAction)
  contactId       String      @map("contact_id") @db.Uuid
  conversationId  String?     @map("conversation_id") @db.Uuid
  title           String
  // Em centavos; null = sem valor definido.
  valueCents      Int?        @map("value_cents")
  // Responsável (membership); null = ninguém ainda (fila de leads).
  ownerId         String?     @map("owner_id") @db.Uuid
  // open | won | lost
  status          String      @default("open")
  lostReason      String?     @map("lost_reason")
  closedAt        DateTime?   @map("closed_at") @db.Timestamptz(3)
  // Ordem dentro da etapa (menor = mais acima). Fracionária: mover um negócio
  // entre dois outros não renumera a etapa.
  position        Float
  // Quando entrou na etapa atual ("parado há X" nas automações).
  enteredColumnAt DateTime    @map("entered_column_at") @db.Timestamptz(3)
  createdAt       DateTime    @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, columnId, position])
  @@index([tenantId, conversationId])
  // "Este contato já tem negócio em aberto neste funil?" e a ficha do contato.
  @@index([tenantId, contactId, boardId])
  @@map("deals")
  @@schema("kanban")
}

// Automação de uma coluna. Gatilho em colunas (para consultar): entrada do
// card, tempo parado (idleMinutes) ou evento da conversa (move o card PARA
// esta coluna; dispositionId no gatilho de tabulação). Ações em JSON.
// Os gatilhos de conversa só valem para negócios com conversa.
model AutomationRule {
  id            String          @id @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  boardId       String          @map("board_id") @db.Uuid
  board         Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  columnId      String          @map("column_id") @db.Uuid
  column        BoardColumn     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  triggerType   String          @map("trigger_type")
  idleMinutes   Int?            @map("idle_minutes")
  dispositionId String?         @map("disposition_id") @db.Uuid
  actions       Json
  enabled       Boolean
  // O tempo parado conta a partir daqui (criação/reativação da regra): uma
  // regra nova não dispara para cards que já estavam parados há muito tempo.
  activeSince   DateTime        @map("active_since") @db.Timestamptz(3)
  createdAt     DateTime        @map("created_at") @db.Timestamptz(3)
  runs          AutomationRun[]

  @@index([tenantId, boardId])
  @@index([tenantId, columnId, triggerType])
  @@index([triggerType, enabled])
  @@map("automation_rules")
  @@schema("kanban")
}

// Execução de uma regra. dedupeKey único por regra: cada disparo roda uma
// vez só (evento repetido, sweep repetido) — mensagem nunca sai duplicada.
model AutomationRun {
  id             String         @id @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  ruleId         String         @map("rule_id") @db.Uuid
  rule           AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dealId         String         @map("deal_id") @db.Uuid
  conversationId String?        @map("conversation_id") @db.Uuid
  dedupeKey      String         @map("dedupe_key")
  // running | succeeded | failed
  status         String
  // Resultado de cada ação: [{ type, ok, error? }]
  results        Json
  createdAt      DateTime       @map("created_at") @db.Timestamptz(3)
  finishedAt     DateTime?      @map("finished_at") @db.Timestamptz(3)

  @@unique([ruleId, dedupeKey])
  @@index([tenantId, ruleId, createdAt(sort: Desc)])
  @@map("automation_runs")
  @@schema("kanban")
}
