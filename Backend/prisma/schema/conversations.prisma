// Módulo conversations. Contato, canal e membro são de outros módulos: só ids.

// Uma conversa por contato em cada canal (como o próprio WhatsApp): o status
// alterna entre aberta, pendente e resolvida.
model Conversation {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  channelId          String    @map("channel_id") @db.Uuid
  contactId          String    @map("contact_id") @db.Uuid
  status             String
  // Membro (membership) responsável; null = sem responsável.
  assigneeId         String?   @map("assignee_id") @db.Uuid
  // Equipe da conversa (módulo teams; só o id). null = fila geral.
  teamId             String?   @map("team_id") @db.Uuid
  lastMessageAt      DateTime  @map("last_message_at") @db.Timestamptz(3)
  lastMessagePreview String?   @map("last_message_preview")
  unreadCount        Int       @default(0) @map("unread_count")
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  messages           Message[]

  @@unique([tenantId, channelId, contactId])
  // Caixa de entrada: por status, mais recentes primeiro.
  @@index([tenantId, status, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, assigneeId, lastMessageAt(sort: Desc)])
  @@index([tenantId, teamId, lastMessageAt(sort: Desc)])
  @@map("conversations")
  @@schema("conversations")
}

model Message {
  id                 String       @id @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  conversationId     String       @map("conversation_id") @db.Uuid
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channelId          String       @map("channel_id") @db.Uuid
  direction          String
  kind               String
  text               String?
  // Id no provedor (WhatsApp). Único por canal: webhook duplicado não vira
  // mensagem duplicada. Null enquanto um envio nosso não foi confirmado.
  externalId         String?      @map("external_id")
  status             String
  senderMembershipId String?      @map("sender_membership_id") @db.Uuid
  // Anexo no armazenamento (bucket privado): só a referência; o arquivo sai pela API.
  mediaKey           String?      @map("media_key")
  mediaMimeType      String?      @map("media_mime_type")
  mediaSize          Int?         @map("media_size")
  mediaFileName      String?      @map("media_file_name")
  error              String?
  sentAt             DateTime     @map("sent_at") @db.Timestamptz(3)
  createdAt          DateTime     @map("created_at") @db.Timestamptz(3)

  @@unique([channelId, externalId])
  // Chat: pela hora de envio no WhatsApp (mensagens chegam fora de ordem).
  @@index([tenantId, conversationId, sentAt(sort: Desc), id(sort: Desc)])
  @@map("messages")
  @@schema("conversations")
}
