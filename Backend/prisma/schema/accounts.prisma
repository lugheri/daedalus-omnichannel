// Módulo accounts. Relations só entre models DESTE módulo; o usuário
// (módulo identity) é referenciado apenas pelo id.

model Tenant {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  status    String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  roles       Role[]
  memberships Membership[]
  invitations Invitation[]

  @@map("tenants")
  @@schema("accounts")
}

model Role {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String?
  name        String
  permissions String[]
  isSystem    Boolean  @map("is_system")
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  memberships Membership[]
  invitations Invitation[]

  @@unique([tenantId, name])
  @@unique([tenantId, key])
  @@map("roles")
  @@schema("accounts")
}

model Membership {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  status    String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  // Uma pessoa tem no máximo um vínculo por tenant.
  @@unique([tenantId, userId])
  // Login: "em quais tenants este usuário pode entrar?"
  @@index([userId])
  @@map("memberships")
  @@schema("accounts")
}

model Invitation {
  id                    String    @id @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  email                 String
  roleId                String    @map("role_id") @db.Uuid
  // Só o hash do token do link; o token em claro nunca é guardado.
  tokenHash             String    @unique @map("token_hash")
  invitedByMembershipId String    @map("invited_by_membership_id") @db.Uuid
  status                String
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  acceptedAt            DateTime? @map("accepted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Excluir um cargo apaga o histórico de convites dele (os pendentes são
  // barrados antes, pelo use case).
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@map("invitations")
  @@schema("accounts")
}

// Chave de API da conta (integrações servidor a servidor, ex.: formulário do
// site). O segredo só existe na criação; no banco fica o SHA-256 dele.
model ApiKey {
  id                    String    @id @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  name                  String
  secretHash            String    @map("secret_hash")
  // Primeiros caracteres do segredo, para reconhecer a chave na tela.
  hint                  String
  createdByMembershipId String    @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  lastUsedAt            DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("api_keys")
  @@schema("accounts")
}
