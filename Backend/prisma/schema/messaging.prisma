// Módulo messaging: envio de e-mail e SMS pelas contas dos próprios clientes.

// Provedor de um canal ("email" | "sms") da conta — no máximo um por canal.
// `settings` sem segredos (remetente, Account SID...); o segredo (API key /
// Auth Token) fica cifrado em `secret` (AES-256-GCM, ENCRYPTION_KEY).
model MessagingProvider {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  channel       String
  settings      Json
  secret        String
  secretHint    String    @map("secret_hint")
  // unverified | verified | failing (resultado do último envio de teste)
  status        String
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, channel])
  @@map("providers")
  @@schema("messaging")
}

// E-mail/SMS enviado a um contato (individual; campanhas também, com campaignId).
// Status só avança: queued → sent → delivered; failed/bounced são finais.
model OutboundMessage {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  channel            String
  contactId          String    @map("contact_id") @db.Uuid
  // Endereço usado no envio (e-mail ou telefone E.164), guardado como foi.
  to                 String
  subject            String?
  body               String
  status             String
  // Motivo da falha (mensagem do provedor) ou da última tentativa sem sucesso.
  error              String?
  providerMessageId  String?   @map("provider_message_id")
  // Quem enviou (membership); null = campanha/sistema.
  sentByMembershipId String?   @map("sent_by_membership_id") @db.Uuid
  campaignId         String?   @map("campaign_id") @db.Uuid
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  sentAt             DateTime? @map("sent_at") @db.Timestamptz(3)
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz(3)
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  // Um contato entra uma vez só em cada campanha (montagem retomável). Nas
  // mensagens individuais, campaignId é null e não conta (NULLs são distintos).
  @@unique([campaignId, contactId])
  @@index([tenantId, contactId, createdAt(sort: Desc)])
  @@index([tenantId, campaignId])
  @@map("outbound_messages")
  @@schema("messaging")
}

// Descadastro por canal e endereço: nada mais é enviado para ele (até um
// gestor reativar a pedido do próprio contato).
model OptOut {
  tenantId  String   @map("tenant_id") @db.Uuid
  channel   String
  address   String
  // unsubscribe_link | sms_reply | provider | manual
  source    String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@id([tenantId, channel, address])
  @@map("opt_outs")
  @@schema("messaging")
}

// Campanha de e-mail ou SMS para um público (filtro de contatos).
// draft → scheduled → sending → sent; canceled a qualquer momento antes de acabar.
model Campaign {
  id                    String    @id @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  name                  String
  channel               String
  subject               String?
  // Texto com {{nome}} / {{nome_completo}}.
  body                  String
  // Filtro do público: { search?, source?, sourceDetail? }.
  audience              Json
  status                String
  scheduledAt           DateTime? @map("scheduled_at") @db.Timestamptz(3)
  startedAt             DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt            DateTime? @map("finished_at") @db.Timestamptz(3)
  // Montagem do público, em lotes (retomável se o worker cair no meio).
  audienceCursor        String?   @map("audience_cursor")
  queuedCount           Int       @default(0) @map("queued_count")
  skippedNoAddress      Int       @default(0) @map("skipped_no_address")
  skippedOptedOut       Int       @default(0) @map("skipped_opted_out")
  createdByMembershipId String    @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt(sort: Desc)])
  // A varredura: agendadas que já venceram, de todas as contas.
  @@index([status, scheduledAt])
  @@map("campaigns")
  @@schema("messaging")
}
