{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/e2e/.*\\.e2e-spec\\.ts$",
  "transform": { "^.+\\.ts$": "ts-jest" },
  "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/e2e/setup-env.ts"],
  "testTimeout": 30000
}
