NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://omnichannel:troque-esta-senha@127.0.0.1:5432/omnichannel


# Gere um segredo proprio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://localhost:5180
TRUST_PROXY=false
APP_URL=http://localhost:5180

# Opcionais (valores padrão abaixo)
LOG_LEVEL=info
QUEUE_PREFIX=omni
WORKER_HEALTH_PORT=3001

# Criptografia de segredos no banco. Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
CONNECTOR_HEALTH_PORT=3002

# Arquivos (API S3). Dev: MinIO do Docker/compose.dev.yaml (senha = MINIO_ROOT_PASSWORD do Docker/.env).
# Producao: S3 compativel; credenciais via Docker secrets (docs/deploy.md).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=omnichannel
S3_ACCESS_KEY=omnichannel
S3_SECRET_KEY=troque-esta-senha
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_MB=25
