# Copie para .env na VM de dados (fora do git).

# IP da VM na rede PRIVADA (o que os nós do Swarm usam para chegar aqui).
PRIVATE_IP=10.0.0.2

# Bucket de backups (de preferência outro bucket/conta que o de mídia).
BACKUP_S3_ENDPOINT=https://s3.provedor.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=omnichannel-backups
BACKUP_RETENTION_DAYS=14
# Formato cron (UTC).
BACKUP_CRON=0 3 * * *
