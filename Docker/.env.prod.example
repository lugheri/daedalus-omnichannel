# Copie para .env.prod (fora do git) no nó manager do Swarm.
# Aqui só configuração NÃO secreta; segredos são Docker secrets (docs/deploy.md).

APP_DOMAIN=app.seudominio.com.br
API_DOMAIN=api.seudominio.com.br
# E-mail para o Let's Encrypt (avisos de expiração de certificado).
ACME_EMAIL=voce@seudominio.com.br

# Imagens publicadas pelo GitHub Actions (release.yml).
IMAGE_REGISTRY=ghcr.io/lugheri
# Versão a publicar; normalmente passada na linha de comando: IMAGE_TAG=v1.0.0 ./deploy.sh
IMAGE_TAG=

# Armazenamento S3 compatível do provedor (as chaves de acesso são secrets).
S3_ENDPOINT=https://s3.provedor.com
S3_REGION=us-east-1
S3_BUCKET=omnichannel-prod
# true para a maioria dos S3 compatíveis (MinIO, Hetzner, OVH...); false para AWS S3.
S3_FORCE_PATH_STYLE=true
